{
  "expo": {
    "name": "ResoSync",
    "slug": "resosync",
    "version": "1.0.0",
    "scheme": "resosync",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#09090B",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.resosync.app"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ResoSync to access your camera to scan attendance QR codes."
        }
      ],
      "expo-notifications"
    ]
  }
}
